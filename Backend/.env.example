# Copy to .env for local development. In production set these in the Vercel project settings.

ENVIRONMENT=development

# LLM (Gemini). Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Any Gemini model that supports structured output. Check AI Studio for the current free models.
LLM_MODEL=gemini-2.5-flash

# Supabase: Project settings -> API. The service role key is SECRET and backend-only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Only needed for legacy projects that still sign tokens with a shared HS256 secret.
# New projects use the JWKS endpoint automatically.
SUPABASE_JWT_SECRET=

# Auth is mandatory in production. For local work without Supabase set AUTH_REQUIRED=false.
AUTH_REQUIRED=true
DAILY_QUOTA=10

# CORS: the extension's origin is chrome-extension://<id>
CHROME_EXTENSION_IDS=
ALLOWED_ORIGINS=

# Limits (4 MB stays under Vercel's request body limit)
MAX_PDF_SIZE_MB=4
MAX_PDF_PAGES=10
