{
  "manifest_version": 3,
  "name": "IntrvuFit - Resume optimizer",
  "version": "0.1.0",
  "description": "Compare your resume with a LinkedIn job posting and get a fit score with concrete improvements.",
  "minimum_chrome_version": "114",
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_title": "IntrvuFit - Resume Optimizer",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "identity"],
  "host_permissions": ["https://www.linkedin.com/*", "https://*.linkedin.com/*"],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.linkedin.com/jobs/*",
        "https://www.linkedin.com/company/*/jobs/*",
        "https://*.linkedin.com/company/*/jobs/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["index.html", "assets/*", "side-panel.css", "launcher-button.css"],
      "matches": ["https://www.linkedin.com/*", "https://*.linkedin.com/*"]
    }
  ]
}
