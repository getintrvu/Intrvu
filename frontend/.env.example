# Copy to .env (or .env.local). Everything here ends up in the public extension bundle, so only
# put public values in it. NEVER put a Supabase service role key or any secret here.

# Backend base URL, no trailing slash. Its origin is added to the manifest host permissions.
VITE_API_BASE_URL=http://localhost:8000

# Supabase project URL and the public "anon" key (Project settings -> API).
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=

# Optional: fixed extension key so the extension id stays the same between builds. Generate once
# (see README) and keep the id in the Supabase redirect allow-list and the backend CHROME_EXTENSION_IDS.
EXTENSION_PUBLIC_KEY=
